<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>summary_goal_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@goal_days_count@</string>
		<key>goal_days_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>u</string>
			<key>zero</key>
			<string>Vous n’avez pas atteint votre objectif au cours des %2$@ derniers jours.</string>
			<key>one</key>
			<string>Vous avez atteint votre objectif 1 fois au cours des %2$@ derniers jours (%3$@).</string>
			<key>many</key>
			<string>Vous avez atteint votre objectif %1$u fois au cours des %2$@ derniers jours (%3$@).</string>
			<key>other</key>
			<string>Vous avez atteint votre objectif %1$u fois au cours des %2$@ derniers jours (%3$@).</string>
		</dict>
	</dict>
</dict>
</plist>
