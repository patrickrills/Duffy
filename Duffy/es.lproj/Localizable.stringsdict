<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>summary_goal_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@goal_days_count@</string>
		<key>goal_days_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>u</string>
			<key>zero</key>
			<string>No has alcanzado tu objetivo en los últimos %2$@ días.</string>
			<key>one</key>
			<string>Has alcanzado tu objetivo 1 vez en los últimos %2$@ días (%3$@).</string>
			<key>many</key>
			<string>Has alcanzado tu objetivo %1$u veces en los últimos %2$@ días (%3$@).</string>
			<key>other</key>
			<string>Has alcanzado tu objetivo %1$u veces en los últimos %2$@ días (%3$@).</string>
		</dict>
	</dict>
</dict>
</plist>
